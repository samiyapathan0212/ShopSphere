# ------------------------------------------------------------------
# ShopSphere environment variables (LOCAL DEVELOPMENT ONLY).
# Copy this file to `.env` and adjust values as needed.
# NEVER commit real credentials or secrets to version control.
# ------------------------------------------------------------------

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD=shopsphere
POSTGRES_DB=shopsphere
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=shopsphere

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Development-only placeholder secret (base64-encoded). In production, generate
# a strong random secret (e.g. `openssl rand -base64 64`) and set it as
# JWT_SECRET. NEVER commit real secrets.
JWT_SECRET=ZGV2LW9ubHktc2hvcHNwaGVyZS1qd3Qtc2VjcmV0LWtleS1wbGFjZWhvbGRlci0wMTIzNDU2Nzg5YWJjZGVm
# Access token lifetime in milliseconds (15 minutes by default).
JWT_EXPIRATION_MS=900000

# --- Application ---
SERVER_PORT=8080

# --- Frontend ---
# Base URL of the backend API used by the frontend build.
VITE_API_URL=/api