# ------------------------------------------------------------------
# ShopSphere environment variables (LOCAL DEVELOPMENT ONLY).
# Copy this file to `.env` and adjust values as needed.
# NEVER commit real credentials or secrets to version control.
# ------------------------------------------------------------------

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD=shopsphere
POSTGRES_DB=shopsphere
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=shopsphere

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# REQUIRED. The backend has no fallback: if this is unset or unusable, startup
# fails with an explicit error instead of signing tokens with a known key.
# The value below is a DEVELOPMENT PLACEHOLDER ONLY. In production, generate a
# strong random secret (e.g. `openssl rand -base64 64`) and set JWT_SECRET to
# it. NEVER commit a real secret.
JWT_SECRET=ZGV2LW9ubHktc2hvcHNwaGVyZS1qd3Qtc2VjcmV0LWtleS1wbGFjZWhvbGRlci0wMTIzNDU2Nzg5YWJjZGVm
# Access token lifetime in milliseconds (15 minutes by default).
JWT_EXPIRATION_MS=900000
# Refresh-token lifetime in milliseconds (30 days by default).
REFRESH_TOKEN_EXPIRATION_MS=2592000000
# Send the refresh-token cookie with the Secure attribute (default true).
# Keep true for HTTPS deployments. Browsers treat http://localhost as a secure
# context, so local Docker development works unchanged. Set to false ONLY for
# plain-HTTP development on a non-localhost host.
REFRESH_TOKEN_COOKIE_SECURE=true

# --- CORS ---
# Comma-separated browser origins allowed to call the API cross-origin.
# The value below is the SAFE LOCAL-DEVELOPMENT example: the storefront runs on
# localhost:3000 (Vite dev server and the nginx container), but the API is
# reached on another host:port, so the browser's Origin header is treated as
# cross-origin and MUST be allow-listed or every POST is rejected (403).
# For production, set your real frontend origin(s), for example:
#   CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
# Never use "*": credentials are allowed, and browsers reject a wildcard
# origin together with credentials. Request origins not listed here are refused.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API documentation ---
# Set to false to remove the Swagger UI and the OpenAPI document entirely
# (recommended in production, where they would otherwise be publicly readable).
SWAGGER_ENABLED=true

# --- Application ---
SERVER_PORT=8080

# --- Frontend ---
# Base URL of the backend API used by the frontend build.
VITE_API_URL=/api